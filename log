
import os
import logging
from datetime import datetime

import psycopg2
from psycopg2 import sql
from openpyxl import load_workbook


# ==========================================
# CONFIGURATION
# ==========================================

EXCEL_FILE = os.path.join(
    os.path.dirname(os.path.abspath(__file__)),
    "IT_Inventory.xlsx"
)

DB_CONFIG = {
    "host": "YOUR_PG_HOST",
    "port": 5432,
    "database": "YOUR_DATABASE",
    "user": "YOUR_USERNAME",
    "password": "YOUR_PASSWORD",
    "connect_timeout": 10
}

TABLE_SCHEMA = "isms"
TABLE_NAME = "computerinfooffline"

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s"
)


# ==========================================
# DATABASE COLUMNS
# ==========================================

DB_COLUMNS = [
    "computername",
    "ipaddress",
    "osuserid",
    "trndate",
    "updatedate",
    "domainname",
    "osversion",
    "ostype",
    "cpu",
    "memory",
    "availablememory",
    "hdddrivesname",
    "hddsize",
    "processcount",
    "osinstalltime",
    "osstarttime",
    "mbinfo",
    "powerstatus",
    "batterystatus",
    "ofcntrtscan",
    "ofctmlisten",
    "ofcversion",
    "usbfile",
    "computersn",
    "osversionnum",
    "totalcpu",
    "appversion",
    "sitename",
    "wirelessname"
]

TIMESTAMP_COLUMNS = {
    "trndate",
    "updatedate"
}


# ==========================================
# HELPER FUNCTIONS
# ==========================================

def convert_value(column, value):

    if value is None or value == "":
        return None

    if column in TIMESTAMP_COLUMNS:

        if isinstance(value, datetime):
            return value

        if isinstance(value, str):
            return datetime.strptime(
                value,
                "%Y-%m-%d %H:%M:%S"
            )

    return str(value).strip()


def get_column_map(sheet):

    headers = {}

    for col in range(1, sheet.max_column + 1):

        value = sheet.cell(1, col).value

        if value:
            headers[str(value).strip()] = col

    return headers


# ==========================================
# CONNECT POSTGRESQL
# ==========================================

def connect_db():

    return psycopg2.connect(**DB_CONFIG)


# ==========================================
# INSERT DATA
# ==========================================

def insert_data(cursor, row_data):

    columns = [
        sql.Identifier(column)
        for column in DB_COLUMNS
    ]

    placeholders = [
        sql.Placeholder()
        for _ in DB_COLUMNS
    ]

    query = sql.SQL(
        """
        INSERT INTO {}.{} ({})
        VALUES ({})
        """
    ).format(
        sql.Identifier(TABLE_SCHEMA),
        sql.Identifier(TABLE_NAME),
        sql.SQL(", ").join(columns),
        sql.SQL(", ").join(placeholders)
    )

    values = [
        row_data.get(column)
        for column in DB_COLUMNS
    ]

    cursor.execute(query, values)


# ==========================================
# MAIN PROCESS
# ==========================================

def main():

    if not os.path.exists(EXCEL_FILE):
        raise FileNotFoundError(EXCEL_FILE)

    logging.info("Opening Excel: %s", EXCEL_FILE)

    workbook = load_workbook(EXCEL_FILE)

    sheet = workbook["ComputerInfo"]

    headers = get_column_map(sheet)

    required_headers = DB_COLUMNS + [
        "SyncStatus",
        "SyncTime",
        "SyncError"
    ]

    missing = [
        name for name in required_headers
        if name not in headers
    ]

    if missing:
        raise ValueError(
            f"Missing Excel columns: {missing}"
        )

    # Connect PostgreSQL

    conn = connect_db()

    success = 0
    failed = 0
    skipped = 0

    try:

        cursor = conn.cursor()

        for row_number in range(2, sheet.max_row + 1):

            status_cell = sheet.cell(
                row_number,
                headers["SyncStatus"]
            )

            status = str(
                status_cell.value or ""
            ).strip().upper()

            # Only process PENDING rows

            if status != "PENDING":
                skipped += 1
                continue

            row_data = {}

            for column in DB_COLUMNS:

                cell_value = sheet.cell(
                    row_number,
                    headers[column]
                ).value

                row_data[column] = convert_value(
                    column,
                    cell_value
                )

            # IP address is NOT NULL in PostgreSQL

            if not row_data["ipaddress"]:
                row_data["ipaddress"] = "0.0.0.0"

            try:

                insert_data(cursor, row_data)

                conn.commit()

                status_cell.value = "SYNCED"

                sheet.cell(
                    row_number,
                    headers["SyncTime"]
                ).value = datetime.now()

                sheet.cell(
                    row_number,
                    headers["SyncError"]
                ).value = None

                success += 1

                logging.info(
                    "Row %s inserted: %s",
                    row_number,
                    row_data["computername"]
                )

            except Exception as error:

                conn.rollback()

                status_cell.value = "ERROR"

                sheet.cell(
                    row_number,
                    headers["SyncTime"]
                ).value = datetime.now()

                sheet.cell(
                    row_number,
                    headers["SyncError"]
                ).value = str(error)[:1000]

                failed += 1

                logging.exception(
                    "Failed row %s",
                    row_number
                )

            # Save Excel after every processed row

            workbook.save(EXCEL_FILE)

        cursor.close()

    finally:

        conn.close()
        workbook.close()

    logging.info("==============================")
    logging.info("SYNC COMPLETED")
    logging.info("SUCCESS : %s", success)
    logging.info("FAILED  : %s", failed)
    logging.info("SKIPPED : %s", skipped)
    logging.info("==============================")


if __name__ == "__main__":

    try:
        main()

    except Exception as error:
        logging.exception("SYNC PROCESS ERROR")
