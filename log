            const payload = {
                nvr_ip: nvrIp,
                nvr_cameraid: nvr_cameraid,
                ipaddress: ipaddress,
                remark: newValue || null
            };

            try {
                const data = await getMqttData(mqttTopic, payload);

                if (data && data.success) {
                    statusEl.style.color = '#4caf50';
                    statusEl.textContent = newValue ? dict.save_success : dict.delete_success;

                    // --- RELOAD lại toàn bộ bảng từ server (thay vì chỉ patch local) ---
