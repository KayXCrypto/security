    <script>
        // --- BIÃ¡ÂºÂ¾N TOÃƒâ‚¬N CÃ¡Â»Â¤C ---
        let CURRENT_DETAIL_DATA = null;
        let CURRENT_TYPE = "";
        let PREVIOUS_TYPE = "";
        let CURRENT_LANG = localStorage.getItem('lang') || 'zh';
        let GLOBAL_CONTACTS_DATA = [];
        let CAMERA_FILTER = null;          // null = hiển thị tất cả
        const CAMERA_STATUS_IDX = 9;       // cột status (cuối cùng) trong row của SQL detail.camera
        let CAMERA_COUNTS = { offline: 0, covered: 0 };


        // Lọc theo nút đang chọn, rồi bỏ cột status (cuối) để bảng không bị lệch cột
        function getCameraRows(rows) {
            let result = rows || [];
            if (CAMERA_FILTER) {
                result = result.filter(r => String(r[CAMERA_STATUS_IDX] || '').toLowerCase() === CAMERA_FILTER);
            }
            return result.map(r => r.slice(0, CAMERA_STATUS_IDX));
        }

        function applyCameraFilterLabels() {
            const t = {
                zh: { offline: '离线', covered: '遮挡' },
                vi: { offline: 'Offline', covered: 'Bị che' },
                en: { offline: 'Offline', covered: 'Covered' }
            }[CURRENT_LANG];

            const btnOff = document.getElementById('btn-filter-offline');
            const btnCov = document.getElementById('btn-filter-covered');

            btnOff.innerHTML = `${t.offline} <span class="filter-count">${CAMERA_COUNTS.offline}</span>`;
            btnCov.innerHTML = `${t.covered} <span class="filter-count">${CAMERA_COUNTS.covered}</span>`;

            btnOff.classList.toggle('active', CAMERA_FILTER === 'offline');
            btnCov.classList.toggle('active', CAMERA_FILTER === 'covered');
        }

        // Bấm lần nữa vào nút đang chọn thì bỏ lọc, quay lại hiển thị tất cả
        function setCameraFilter(status) {
            CAMERA_FILTER = (CAMERA_FILTER === status) ? null : status;
            applyCameraFilterLabels();
            if (CURRENT_DETAIL_DATA && CURRENT_DETAIL_DATA.rows) {
                renderTable(CURRENT_DETAIL_DATA.rows, CURRENT_TYPE);
            }
        }

        // --- QUÃ¡ÂºÂ¢N LÃƒ NGÃƒâ€N NGÃ¡Â»Â® ---
        function setLanguage(lang) {
            CURRENT_LANG = lang;
            localStorage.setItem('lang', lang);
            const dict = window.i18n[lang];
            if (!dict) return;

            document.getElementById('contact-title-text').textContent = dict.contact_title;
            document.getElementById('title').textContent = dict.title;

            const keys = ['camera', 'nvr', 'face', 'hr_face', 'perm', 'accesscontrol', 'hr_door', 'magnetdoor', 'visitor', 'cameraexception'];
            keys.forEach(key => {
                const titleEl = document.getElementById(`${key}-title-text`);
                if (titleEl) titleEl.textContent = dict[key];

                const unit = key.includes('hr') || key.includes('visitor') ? dict.unit_ren : dict.unit_tai;
                const abnormalLabel = document.querySelector(`#${key}-abnormal + .circle-label`);
                if (abnormalLabel) abnormalLabel.textContent = `${dict.abnormal}(${unit})`;

                const normalLabel = document.querySelector(`#${key}-normal + .circle-label`);
                if (normalLabel) normalLabel.textContent = `${dict.normal}(${unit})`;

                const timeTitleEl = document.getElementById(`${key}-time-title-text`);
                if (timeTitleEl && dict.update_time) {
                    timeTitleEl.textContent = dict.update_time;
                }
            });

            const sectionLabel = document.getElementById('section-label-text');
            if (sectionLabel) {
                sectionLabel.textContent = (dict.abnormal_detail || "Abnormal Detail") + ":";
            }

            document.querySelectorAll('.lang-switch span').forEach(el => el.classList.remove('active'));
            document.getElementById(`lang-${lang}`).classList.add('active');

            const exceptionLabel = document.getElementById('camera-exception-label');
            if (exceptionLabel) exceptionLabel.textContent = `${dict.exception}(${dict.unit_tai})`;

            // TÃ¡Â»Â± Ã„â€˜Ã¡Â»â„¢ng vÃ¡ÂºÂ½ lÃ¡ÂºÂ¡i cÃ¡ÂºÂ¥u trÃƒÂºc Modal nÃ¡ÂºÂ¿u Ã„â€˜ang hiÃ¡Â»Æ’n thÃ¡Â»â€¹ dÃ¡Â»Â¯ liÃ¡Â»â€¡u
            const overlay = document.getElementById('overlay');
            if (overlay && overlay.classList.contains('active')) {
                if (CURRENT_TYPE === "it_contacts") {
                    openContactsModal();
                } else if (CURRENT_DETAIL_DATA && CURRENT_DETAIL_DATA.rows) {
                    const isSub = CURRENT_TYPE.startsWith('sub_');
                    if (!isSub) {
                        document.getElementById('modal-title').textContent = `${dict[CURRENT_TYPE]} - ${dict.abnormal_detail}`;
                    }
                    renderTable(CURRENT_DETAIL_DATA.rows, CURRENT_TYPE, isSub);
                }
            }

            document.getElementById('edit-modal-title').textContent =
                dict.edit_exception;

            document.getElementById('edit-exclude-label').innerHTML =
                `${dict.exclude_label}
                    <span style="color:#888;font-size:11px;margin-left:8px">
                        
                    </span>`;

            document.getElementById('edit-exclude-input').placeholder =
                dict.exclude_placeholder;

            document.getElementById('edit-btn-cancel').textContent =
                dict.cancel;

            // document.getElementById('btn-delete-exception').innerHTML =
            //     dict.delete_exception;

            document.getElementById('edit-btn-save').textContent =
                '💾' + dict.save;
            if (document.getElementById('edit-overlay').classList.contains('active')) {
                const btn = document.querySelector('#modal-table-container .btn-edit-remark[data-row-index="' + EDIT_ROW_INDEX + '"]');
                if (btn) openEditModal(EDIT_ROW_INDEX, btn);
            }

            // Cáº­p nháº­t login modal theo ngÃ´n ngá»¯
            document.getElementById('login-modal-title').textContent = dict.login_title || '🔒 Login';
            document.getElementById('login-label-username').textContent = dict.login_username || 'Username';
            document.getElementById('login-label-password').textContent = dict.login_password || 'Password';
            document.getElementById('login-btn-cancel').textContent = dict.cancel || 'Cancel';
            document.getElementById('login-btn-submit').textContent = dict.login_submit || 'Login';
            const loginInput = document.getElementById('login-password');
            if (loginInput) loginInput.placeholder = dict.login_password_placeholder || '';
            applyCameraFilterLabels();
        }

        // --- KÃ¡ÂºÂ¾T NÃ¡Â»I MQTT ---mqtt://localhost:1883
        const mqttClient = mqtt.connect('wss://wvnitsec.wistron.com/mqtt', {
            keepalive: 30,
            protocolVersion: 4,
            clean: true,
            reconnectPeriod: 1000,
            connectTimeout: 30 * 1000
        });

        mqttClient.on('connect', () => {
            console.log("MQTT Connected");
